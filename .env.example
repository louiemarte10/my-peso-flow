# Copy this file to .env and fill it in. Never commit the real .env.

# ── Neon Postgres (create a NEW project, separate from amarah-buko-juice) ──
# POOLED connection (host contains "-pooler"). Used by the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
# DIRECT connection (no "-pooler"). Used for migrations / prisma db push.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Session cookie signing secret ──
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# ── Sign in with Google (optional — leave blank to hide the button) ──
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI (local):  http://localhost:3000/api/auth/google/callback
# Authorised redirect URI (prod):   https://YOUR-DOMAIN/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Public base URL used to build the Google redirect URI.
# Local: http://localhost:3000 — Vercel: https://your-app.vercel.app
APP_URL="http://localhost:3000"

# Comma-separated allow-list of Google emails that may sign in.
# Leave blank to allow any Google account (not recommended for a personal app).
ALLOWED_EMAILS="ldbopz17@gmail.com"

# ── Seed account (npm run db:seed) ──
SEED_NAME="Louie Marte"
SEED_EMAIL="ldbopz17@gmail.com"
SEED_PASSWORD="pesoflow123"
