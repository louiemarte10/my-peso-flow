// myPesoFlow — personal earnings & expense tracker with wallets.
// Prisma 7 schema. Money is stored as integer centavos (₱1 = 100) so we never
// hit floating-point rounding; the API layer converts to/from pesos.
// Dates are stored as the UTC instant of 00:00 Manila for that calendar day.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum EntryKind {
  EARNING
  EXPENSE
}

/// Where a proposed entry stands.
///
/// PENDING  waiting for you to look it over
/// APPROVED you said yes, but it is NOT money yet — it posts at 4pm Manila
///          on its own date, not a moment before
/// POSTED   the date came, the entry is in the ledger
/// SKIPPED  not this time
enum ScheduleStatus {
  PENDING
  APPROVED
  POSTED
  SKIPPED
}

enum WalletType {
  BANK // Security Bank, BPI, GoTyme…
  EWALLET // GCash, Maya…
  CASH // physical cash on hand
  SAVINGS // a set-aside / ipon fund
  CREDIT // credit card or line
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String? // null for Google-only accounts
  googleId     String?  @unique
  imageUrl     String?
  role         Role     @default(USER)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  categories    Category[]
  entries       Entry[]
  wallets       Wallet[]
  transfers     Transfer[]
  activity      ActivityLog[]
  scheduleRules ScheduleRule[]
  scheduled     ScheduledEntry[]
}

/// An append-only record of who did what, for the admin Activity page.
/// The actor's name and email are copied in rather than only referenced, so a
/// deleted account does not erase the history of what it did.
model ActivityLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  actorName  String
  actorEmail String
  /// "entry.create", "category.archive", "auth.login", ...
  action  String
  /// One readable sentence, written at the time it happened.
  summary String

  targetType String? // Entry | Transfer | Wallet | Category | User | Account
  targetId   String?

  /// Set when an admin did this while using "Log in as".
  impersonatedByEmail String?

  /// Null once the account is deleted; the snapshot above still stands.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, createdAt])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  kind     EntryKind
  color    String? // hex used by the charts, e.g. "#0078BF"
  /// Set when archived. Null means live. A timestamp rather than a boolean so
  /// the Archived page can show when something was put away.
  archivedAt DateTime?
  /// Catch-all categories like "Others" say nothing on their own, so turning
  /// this on makes the note mandatory when encoding against them — you have to
  /// write what it actually was.
  requiresDetail Boolean  @default(false)
  /// Optional spending cap for one Manila calendar month, in centavos. Null
  /// means no limit. Only meaningful on EXPENSE categories; an earning has
  /// nothing to cap. Nothing is blocked when you go over — the app tells you
  /// where you stand and leaves the decision to you.
  monthlyLimitCents Int?
  createdAt      DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries       Entry[]
  scheduleRules ScheduleRule[]
  scheduled     ScheduledEntry[]

  @@unique([userId, kind, name])
  @@index([userId, kind])
}

/// A place money actually sits: a bank account, an e-wallet, cash in your
/// pocket. Its balance is derived — opening balance, plus earnings paid into
/// it, minus expenses paid out of it, plus/minus transfers.
model Wallet {
  id                  String     @id @default(cuid())
  name                String
  type                WalletType @default(EWALLET)
  color               String? // hex, used on the wallet cards
  icon                String? // one emoji, used when there is no logo
  /// An uploaded logo (GCash, a bank, …) as a small square PNG data URL.
  /// Stored inline rather than on disk because the host filesystem is
  /// read-only; the browser shrinks it to 128px first, so it stays a few KB.
  logo                String?
  accountRef          String? // optional nickname / last 4 digits
  openingBalanceCents Int        @default(0)
  /// Warn when the balance drops to or below this. 0 disables the warning.
  lowBalanceCents     Int        @default(0)
  archivedAt          DateTime?
  sortOrder           Int        @default(0)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  entries       Entry[]
  transfersFrom Transfer[] @relation("TransferFrom")
  transfersTo   Transfer[] @relation("TransferTo")
  scheduleRules ScheduleRule[]
  scheduled     ScheduledEntry[]

  @@unique([userId, name])
  @@index([userId, archivedAt])
}

model Entry {
  id          String    @id @default(cuid())
  date        DateTime // 00:00 Manila for the calendar day, stored as UTC
  kind        EntryKind
  amountCents Int
  note        String?
  /// Archived entries keep their row but are excluded from every total,
  /// balance and chart until restored.
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Which wallet the money landed in (earning) or came out of (expense).
  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, kind, date])
  @@index([userId, walletId, date])
  @@index([userId, archivedAt])
}

/// Money moving between your own wallets — an ATM withdrawal, a bank-to-GCash
/// cash-in, setting money aside into savings. It is never income or an expense,
/// only a move, so it never touches your earnings/expense totals. `feeCents` is
/// the charge the move itself cost (ATM fee, cash-in fee) and IS real money
/// gone from the source wallet.
model Transfer {
  id          String   @id @default(cuid())
  date        DateTime
  amountCents Int
  feeCents    Int       @default(0)
  note        String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  fromWalletId String
  fromWallet   Wallet @relation("TransferFrom", fields: [fromWalletId], references: [id], onDelete: Cascade)

  toWalletId String
  toWallet   Wallet @relation("TransferTo", fields: [toWalletId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, fromWalletId])
  @@index([userId, toWalletId])
  @@index([userId, archivedAt])
}

/// A repeating entry you expect on fixed days of the month — "every 5th and
/// 20th, ₱3,000 to Hatag Aizel".
///
/// A rule never writes to the ledger. All it does is PROPOSE: generating turns
/// it into ScheduledEntry rows that sit in a review table until you approve
/// them. That separation is the whole point — an app that quietly invents
/// ₱3,000 expenses you never checked is worse than no app.
model ScheduleRule {
  id          String    @id @default(cuid())
  name        String
  kind        EntryKind
  amountCents Int
  /// Manila days of the month this falls on, e.g. [5, 20]. A 29–31 is clamped
  /// to the last day of a short month, so February never skips a payday.
  daysOfMonth Int[]
  /// Copied onto every proposal it makes, so you can say what the money is for
  /// once instead of on every occurrence.
  note        String?
  /// Off means it stops proposing, without losing the rule or its history.
  active      Boolean   @default(true)
  /// On: this comes round every month, for as long as the rule lives.
  /// Off: it happens once, on its next date, and then proposes nothing more.
  repeatMonthly Boolean @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  occurrences ScheduledEntry[]

  @@index([userId, active])
}

/// One proposed date from a rule, waiting in the review table.
///
/// Nothing here counts as money: it is absent from every total, balance and
/// chart. Approving it is what creates the real Entry, and `entryId` points at
/// the row it became so the two can never be confused for each other.
model ScheduledEntry {
  id          String         @id @default(cuid())
  date        DateTime // 00:00 Manila for the calendar day, stored as UTC
  kind        EntryKind
  amountCents Int
  note        String?
  status      ScheduleStatus @default(PENDING)
  /// When this actually became a ledger entry — 4pm Manila on its own date,
  /// never at the moment you approved it.
  postedAt    DateTime?
  /// True once you change something on the row by hand. Regenerating then
  /// leaves it alone instead of overwriting your edit with the rule's values.
  edited      Boolean        @default(false)
  approvedAt  DateTime?
  /// The ledger entry this became once it posted. Null until then — an
  /// approved row that has not reached its date has no entry anywhere.
  entryId     String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  /// Null once the rule is deleted — the proposal and its history survive it.
  ruleId String?
  rule   ScheduleRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  walletId String?
  wallet   Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// One proposal per rule per day. Generating again is therefore safe to run
  /// as often as you like — it can never duplicate a row you already have, and
  /// a row you skipped stays skipped instead of coming back.
  @@unique([ruleId, date])
  @@index([userId, status, date])
}
